<UserControl x:Class="Reactivity.UI.Panel.TimeChart.WpfMultiChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Resources>
    <Grid IsHitTestVisible="True" Background="Transparent">
        <Grid.Resources>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="yAxisLabelColumn" Width="30"/>
            <ColumnDefinition Width="Auto"/>           <!-- This is the Y Axis ticker label column -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>             <!-- This is the title row -->
            <RowDefinition Height="0"/>            <!-- this is the Inner Header Interactive section -->
            <RowDefinition Height="*"/>             <!-- this is the main chart area -->
            <RowDefinition Height="Auto"/>             <!-- this is the X Axis ticker label -->
            <RowDefinition Height="Auto" />             <!-- this is the X Axis label -->
        </Grid.RowDefinitions>        

        <!-- This is the chart inner header interactive section -->
        <Grid Margin="0" x:Name="ChartInnerHeader" Grid.Column="3" Grid.Row="2" Background="Transparent">
            <Border BorderBrush="White" BorderThickness="1" >                    
                <WrapPanel Margin="0,2,4,2" Grid.Column ="1" Grid.Row ="1">
                    <WrapPanel x:Name="SeriesLabel" Margin="2,0,2,0"/>
                    <TextBlock x:Name="TickerLabel" Foreground="LightBlue" TextAlignment="Right"/>
                </WrapPanel>
            </Border>
        </Grid >

        <!-- This is the title of the chart -->
        <Grid Grid.Column ="2" Grid.Row="0" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width ="Auto" />
                <ColumnDefinition Width ="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,0,0" x:Name="titleBox" Grid.Column="0"
                       Grid.ColumnSpan="2" FontSize="12"  
                       RenderTransformOrigin="0.5,0.5" Text="Title" 
                       TextTrimming="CharacterEllipsis"                        ToolTip="{Binding ElementName=titleBox, Path=Text}"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                       TextAlignment="Center" Background="Transparent" FontWeight="Bold"/>
        </Grid>
        <!-- end of the title of the chart -->

        <!-- X and Y Labels -->
        <TextBlock Margin="0,0,0,0" x:Name="xAxisLabel" Grid.Column="0" Grid.Row="4"  Grid.ColumnSpan="3" FontSize ="12" RenderTransformOrigin="0.5,0.5" Text="X Label" TextAlignment="Center" Foreground="White" Background="Transparent" />
        <TextBlock Margin="0,0,0,0" x:Name="yAxisLabel" Grid.Column="0" Grid.Row="2" Grid.RowSpan="2" FontSize ="12" RenderTransformOrigin="0.5,0.5" Text="Y Label" TextAlignment="Center"  HorizontalAlignment ="Center" VerticalAlignment ="Center" Foreground="White" Background="Transparent">
            <TextBlock.LayoutTransform>
                <TransformGroup>
                    <TranslateTransform X="0" Y="0"/>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <SkewTransform AngleX="0" AngleY="0"/>
                    <RotateTransform Angle="-90"/>
                    <TranslateTransform X="0" Y="0"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </TextBlock.LayoutTransform>
        </TextBlock>
        <Rectangle Fill="Transparent" Margin="2,0,0,2" x:Name="xGridlineLabels" 
					   Grid.Column="1" 
                       Grid.ColumnSpan="2" Grid.Row="3" 
                       RenderTransformOrigin="0.5,0.5" Stroke="{x:Null}" MinHeight="4"  />
        <Rectangle Fill="Transparent" Margin="2,0,0,2" x:Name="yGridLineLabels" 
                       Grid.Column="1" Grid.Row="2" Grid.RowSpan="2" RenderTransformOrigin="0.5,0.5" 
                       MinHeight ="4" Stroke="{x:Null}">
            <Rectangle.LayoutTransform>
                <TransformGroup>
                    <TranslateTransform X="0" Y="0"/>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <SkewTransform AngleX="0" AngleY="0"/>
                    <RotateTransform Angle="-90"/>
                    <TranslateTransform X="0" Y="0"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Rectangle.LayoutTransform>
        </Rectangle>
        <Canvas Margin="0,0,0,0" x:Name="TextCanvas" Grid.Column="2" 
                    Grid.Row="2" RenderTransformOrigin="0.5,0.5" Background="Transparent" />
        <Canvas  Margin="0,0,0,0" x:Name ="ChartCanvas"   
                     Grid.Column="2" Grid.Row="2" RenderTransformOrigin="0.5,0.5" 
                     ClipToBounds="False" Background="Transparent">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <TranslateTransform X="0" Y="0"/>
                    <ScaleTransform ScaleX="1" ScaleY="-1"/>
                    <SkewTransform AngleX="0" AngleY="0"/>
                    <RotateTransform Angle="0"/>
                </TransformGroup>
            </Canvas.RenderTransform>
        </Canvas>

        <Canvas  Margin="0,0,0,0" x:Name ="ChartTicksCanvas" 
				 Grid.Column ="2" Grid.Row ="2" 
                 RenderTransformOrigin="0.5,0.5" Background="Transparent" />

        <!-- This is the Solid border for the chart area  -->
        <Border Margin="0,0,0,0" Background="{x:Null}" 
				  Grid.Column ="2" Grid.Row ="1" Grid.RowSpan="2" 
                    ClipToBounds="False"
                    BorderBrush="White" BorderThickness="1,1,1,1" />

        <!--  The following the the top interactive layer of the canvas -->
        <Grid Margin="0,0,0,0" x:Name ="ChartInteractiveCanvas"   
				   Grid.Column="2" Grid.Row="2" RenderTransformOrigin="0.5,0.5" ClipToBounds="False" Background="Transparent" >
            <TextBlock Name="noDataAlert" Text="Add sources to the Live Chart by selecting a floor and clicking a device."
                       TextBlock.FontSize="13" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
        </Grid>

    </Grid>

</UserControl>
