<UserControl x:Class="Reactivity.UI.Panel.UserControls.LoadingWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="50" Width="400">
    <Grid Background="Transparent">        
        <DockPanel DockPanel.Dock="Top" VerticalAlignment="Center" Height="50">
            <TextBlock x:Name="message" TextBlock.FontSize="14" Foreground="White" HorizontalAlignment="Center" DockPanel.Dock="Top">asdfasdf</TextBlock>
            <ProgressBar Name="loadingBar" Height="20" Width="400" VerticalAlignment="Center" 
                             HorizontalAlignment="Center" Background="Transparent" BorderBrush="White" BorderThickness="2"
                             DockPanel.Dock="Top"/>
        </DockPanel>
    </Grid>
</UserControl>
